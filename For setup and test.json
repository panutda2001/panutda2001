        "id": "a1b1cee8f5a63847",
        "type": "function",
        "z": "79676b8bffba8ff3",
        "name": "setup tripbit",
        "func": "var uid         = msg.uid;\nvar data        = Array(32);\n\ndata[0]     = 100;\ndata[1]     = 3;\n// data[20]    = 0b01111111;\n// data[20]    = 0b0000000;\n// data[20]    = 0b01111110;\n\ndata[20]    = 0b11111111;  \n// 1, arc 2, Leak 3, Under voltage 4, over voltage 5, Over current 6, Short circit 7, Over temp 8, earth q\n\n\n\n//present value\ndata[14] = 50;                     //  Leakage set value\n\n// data[15] = 35;                      //  rate of Current set vlaue \ndata[15] = 5;                      //  rate of Current set vlaue \n\n\ndata[16] = 180;                     //  Under voltage set\ndata[17] = 0; \n\n// data[18] = 14;                      //  Over voltage set\n// data[19] = 1;\ndata[18] = 240;                      //  Over voltage set\ndata[19] = 0;\n\ndata[21] = 0;                       //  learn_flag \ndata[29] =  97;                     //  voltage offset\ndata[22] = 100;                     //  current offset\n\n\ndata[30] = 2;                       //  sensitive ack\ndata[31] = msg.phase;               //  phase\n\n\n\nconst buffer = Buffer.from(data);\nmsg.topic = \"devices/\"+uid+\"/messages/devicebound/\"\nmsg.payload = buffer;\n\nreturn msg;",
