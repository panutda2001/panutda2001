    {
        "id": "4da7ca66a8acb11f",
        "type": "function",
        "z": "79676b8bffba8ff3",
        "name": "",
        "func": "function convertalarm(data){\n    if(data == 1){\n        return \"arc\"\n    } else if(data == 2){\n        return \"leak\"\n    } else if(data == 4){\n        return \"Under V\"\n    } else if(data == 8){\n        return \"Over V\"\n    } else if(data == 16){\n        return \"Over C\"\n    } else if(data == 32){\n        return \"Short Circuit\"\n    } else if(data == 64){\n        return \"Over Temp\"\n    } else if(data == 128){\n        return \"EQ\"\n    } else if(data > 0){\n        return \"ERROR \" + data\n    } else if(data == 0){\n        return \"normal\"\n    }\n}\n\nvar data_rx_buffer = Buffer.from(msg.payload, 'base64');\nmsg.buff = msg.payload;\nmsg.payload = {\n    order:data_rx_buffer[1],\n    volt:(data_rx_buffer[3]<<8) + data_rx_buffer[2],\n    current:((data_rx_buffer[5]<<8) + data_rx_buffer[4])/10,\n    power:((data_rx_buffer[7]<<8) + data_rx_buffer[6])/10,\n    power_factor:data_rx_buffer[11],\n    leak:data_rx_buffer[10],\n    set_leak:data_rx_buffer[14],\n    set_under_voltage:(data_rx_buffer[17]<<8) + data_rx_buffer[16],\n    set_over_voltage:(data_rx_buffer[19]<<8) + data_rx_buffer[18],\n    set_over_current:data_rx_buffer[15],\n    switch:data_rx_buffer[12],\n    address:data_rx_buffer[38],\n    tripbit:data_rx_buffer[20].toString(2).split(\"\"),\n    faultbit:convertalarm(data_rx_buffer[13]),\n    vol_offset:data_rx_buffer[29],\n    current_offset:data_rx_buffer[22],\n    sensitivity:data_rx_buffer[30],\n    phase:data_rx_buffer[31],\n}\nflow.set('raw',data_rx_buffer);\n\nmsg.order_code = data_rx_buffer[1];\n\n// // check save\n// if(data_rx_buffer[1]){\n    \n// }\n\n//msg.payload = data_rx_buffer\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 120,
        "wires": [
